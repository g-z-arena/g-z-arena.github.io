rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    // غيّر الإيميل ده لإيميل الأدمن (حروف صغيرة) — لازم يكون نفس ADMIN_EMAIL في index.html
    function isAdmin() {
      return signed() && request.auth.token.email.lower() == 'opaidamazed@gmail.com';
    }

    // حدود منطقية لأي تحديث بيعمله اللاعب على حسابه (يمنع تزوير XP والأرقام القياسية من الكونسول)
    function selfOk() {
      let a = request.resource.data;
      let b = resource.data;
      let sa = a.get('scores', {});
      let sb = b.get('scores', {});
      return a.get('xp', 0) - b.get('xp', 0) >= 0 && a.get('xp', 0) - b.get('xp', 0) <= 1500
        && a.get('wins', 0) - b.get('wins', 0) >= 0 && a.get('wins', 0) - b.get('wins', 0) <= 1
        && a.get('played', 0) - b.get('played', 0) >= 0 && a.get('played', 0) - b.get('played', 0) <= 1
        && a.get('spyWins', 0) - b.get('spyWins', 0) >= 0 && a.get('spyWins', 0) - b.get('spyWins', 0) <= 1
        && sa.get('quizPerfect', 0) - sb.get('quizPerfect', 0) <= 1
        && sa.get('quiz', 0) <= 400
        && sa.get('snake', 0) <= 400
        && sa.get('typing', 0) <= 200
        && sa.get('reaction', 9999) >= 100
        && gamesOk() && monthOk()
        && a.get('recent', []).size() <= 10;
    }

    // ===== إحصائيات البروفايل: games (لكل لعبة) / monthly (شهري) / recent (آخر مباريات) =====
    function gm(d, k) { return d.get('games', {}).get(k, {}); }

    // لعبة واحدة: عدّاد اللعب والفوز يزيد بحد أقصى 1 في كل تحديث، والفوز مايعدّيش اللعب
    function gOk(k) {
      let n = gm(request.resource.data, k);
      let o = gm(resource.data, k);
      return n.get('p', 0) - o.get('p', 0) >= 0 && n.get('p', 0) - o.get('p', 0) <= 1
        && n.get('w', 0) - o.get('w', 0) >= 0 && n.get('w', 0) - o.get('w', 0) <= 1
        && n.get('w', 0) <= n.get('p', 0);
    }

    function gamesOk() {
      let a = request.resource.data.get('games', {});
      let b = resource.data.get('games', {});
      return a.diff(b).affectedKeys().hasOnly(['guess', 'spy', 'memory', 'who', 'quiz', 'snake', 'reaction', 'typing'])
        && gOk('guess') && gOk('spy') && gOk('memory') && gOk('who')
        && gOk('quiz') && gOk('snake') && gOk('reaction') && gOk('typing');
    }

    // الشهر الحالي بس (UTC) هو اللي يتعدّل — مفتاحه m202611 مثلًا
    function monthOk() {
      let t = request.time;
      let mk = 'm' + string(t.year()) + (t.month() < 10 ? '0' : '') + string(t.month());
      let a = request.resource.data.get('monthly', {});
      let b = resource.data.get('monthly', {});
      let na = a.get(mk, {});
      let nb = b.get(mk, {});
      return a.diff(b).affectedKeys().hasOnly([mk])
        && na.get('xp', 0) - nb.get('xp', 0) >= 0 && na.get('xp', 0) - nb.get('xp', 0) <= 1500
        && na.get('p', 0) - nb.get('p', 0) >= 0 && na.get('p', 0) - nb.get('p', 0) <= 1
        && na.get('w', 0) - nb.get('w', 0) >= 0 && na.get('w', 0) - nb.get('w', 0) <= 1;
    }

    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('wins', 0) == 0
        && request.resource.data.get('played', 0) == 0;
      allow update: if signed() && (isAdmin() || (request.auth.uid == uid && selfOk()));
    }

    match /rooms/{id} {
      allow read, write: if signed();
    }

    match /events/{id} {
      allow read: if signed();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p']));
    }

    match /puzzles/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    match /quizGames/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    match /quizQuestions/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }
  }
}
